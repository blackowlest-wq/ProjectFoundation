<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Class name="com.example.dailyreport.auth.AuthenticatedUser"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <Match>
        <Class name="com.example.dailyreport.auth.ManagerGroupPermissionRepository"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.example.dailyreport.common.ApiException"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.example.dailyreport.common.ApiExceptionHandler"/>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
    <Match>
        <Class name="com.example.dailyreport.common.ApiExceptionHandler$ErrorResponse"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.example.dailyreport.master.MasterDataRepository"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Spring-managed JdbcTemplate dependencies are intentionally constructor-injected and not copied. -->
    <Match>
        <Class name="com.example.dailyreport.master.MessageCatalogRepository"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- The response record copies its map in the canonical constructor; the accessor is immutable by contract. -->
    <Match>
        <Class name="com.example.dailyreport.master.MessageCatalogController$MessageCatalogResponse"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Invalid TTL is rejected during construction to prevent an unusable cache. -->
    <Match>
        <Class name="com.example.dailyreport.master.MessageCatalogService"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.example.dailyreport.master.MasterDataRepository$WorkSettings"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.example.dailyreport.report.dto.DailyReportResponse"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- DailyReportRequest makes a defensive unmodifiable copy; the record accessor still looks like a mutable List to SpotBugs. -->
    <Match>
        <Class name="com.example.dailyreport.report.dto.DailyReportRequest"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.example.dailyreport.report.entity.DailyReportEntity"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!-- The monthly response record copies each aggregate list in its canonical constructor. -->
    <Match>
        <Class name="com.example.dailyreport.monthlysummary.MonthlySummaryResponse"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Spring-managed JdbcTemplate dependencies are intentionally constructor-injected and not copied. -->
    <Match>
        <Class name="com.example.dailyreport.monthlysummary.JdbcMonthlySummaryRepository"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
